# --- Environnement ----------------------------------------------------------
# dev | test | staging | production
EXAUCE_ENV=dev

# Secret de signature (jetons d'invitation, jeton CSRF, cookies signés).
# En production : secret long aléatoire, jamais committé (page 09 §5).
EXAUCE_SECRET_KEY=dev-only-insecure-secret-change-me-0123456789

# --- Base de données --------------------------------------------------------
EXAUCE_DATABASE_URL=postgresql+asyncpg://exauce:exauce@localhost:5432/exauce

# --- Origines / cookies -----------------------------------------------------
# Liste séparée par des virgules ; CORS avec allow_credentials, sans wildcard.
EXAUCE_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Vide en dev (cookie host-only) ; en prod : .exauceac.com
EXAUCE_COOKIE_DOMAIN=
EXAUCE_PUBLIC_BASE_URL=http://localhost:5173
EXAUCE_API_PUBLIC_BASE_URL=http://localhost:8000

# --- Langue -----------------------------------------------------------------
EXAUCE_DEFAULT_LANG=fr

# --- Limites de débit (page 08 §5) ------------------------------------------
EXAUCE_RATE_LIMIT_PUBLIC_PER_MIN=60
EXAUCE_RATE_LIMIT_CONTACT_PER_10MIN=5
EXAUCE_RATE_LIMIT_ADMIN_PER_MIN=120

# --- Sessions ---------------------------------------------------------------
EXAUCE_SESSION_IDLE_MINUTES=60

# --- Mail (MailHog en dev) --------------------------------------------------
EXAUCE_MAILHOG_HOST=localhost
EXAUCE_MAILHOG_PORT=1025
EXAUCE_MAIL_FROM=no-reply@exauceac.com

# --- Stockage ---------------------------------------------------------------
EXAUCE_MEDIA_ROOT=./media
