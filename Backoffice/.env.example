# Mode de la couche d'accès API : mock (défaut, en mémoire) | prism | http
VITE_API_MODE=mock

# Base de l'API réelle (mode http) et du serveur Prism (mode prism)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_PRISM_BASE_URL=http://localhost:4010

# Délai simulé du mock en millisecondes (0 pour les tests)
VITE_MOCK_LATENCY_MS=120
